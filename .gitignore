# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env

# Local databases (keep the data/ folder, ignore db files)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite3

# Local exports & backups (Phase 3 data portability — never commit user data)
exports/
backups/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated codebase graph / analysis artifacts
graphify-out/

# Streamlit
.streamlit/secrets.toml

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

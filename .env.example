# Copy this file to `.env` and adjust as needed.
# All settings are optional; sensible defaults are used when unset.

# Directory where local data (the SQLite database) is stored.
TRADING_JOURNAL_DATA_DIR=data

# SQLite database file name (kept inside TRADING_JOURNAL_DATA_DIR).
TRADING_JOURNAL_DB_NAME=trading_journal.db

# Optional: fully override the SQLAlchemy database URL.
# If set, this takes precedence over DATA_DIR / DB_NAME above.
# TRADING_JOURNAL_DATABASE_URL=sqlite:///data/trading_journal.db

# Set to 1 to echo SQL statements (useful for debugging).
TRADING_JOURNAL_SQL_ECHO=0

# ---------------------------------------------------------------------------
# Phase 2 — read-only TradeLocker sync (all OPTIONAL).
#
# The local dashboard works with ZERO TradeLocker configuration. These settings
# are only consulted when you run a `tradelocker-*` / `sync-tradelocker` command
# or click a button on the Sync tab.
#
# SECURITY: never commit your real `.env`. Credentials are read from the
# environment only, are never written to the database, and are never logged.
# ---------------------------------------------------------------------------

# Master switch shown in the UI. Sync commands work regardless, but this makes
# the "enabled" intent explicit.
TRADELOCKER_ENABLED=false

# Which TradeLocker environment to talk to: demo or live.
#   demo -> https://demo.tradelocker.com   (default)
#   live -> https://live.tradelocker.com
# DEMO vs LIVE MUST match the account your credentials belong to, or auth fails.
TRADELOCKER_ENVIRONMENT=demo

# Optional: override the base URL (e.g. for a dev proxy). Leave blank to use the
# environment default above. The connector appends `/backend-api` itself.
# TRADELOCKER_BASE_URL=

# Credentials (required only when you actually run a sync/health command).
TRADELOCKER_EMAIL=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=

# Optional default account to sync (otherwise pass --account-id / --acc-num).
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ACC_NUM=

# How far back to pull closed history, request timeout, and the safety default.
TRADELOCKER_SYNC_LOOKBACK_DAYS=90
TRADELOCKER_REQUEST_TIMEOUT_SECONDS=30

# When true, the connector defaults to previewing. The CLI additionally requires
# an explicit `--apply` flag before it will ever write.
TRADELOCKER_DRY_RUN=true

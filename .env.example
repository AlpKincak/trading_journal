# Copy this file to `.env` and adjust as needed.
# All settings are optional; sensible defaults are used when unset.

# Directory where local data (the SQLite database) is stored.
TRADING_JOURNAL_DATA_DIR=data

# SQLite database file name (kept inside TRADING_JOURNAL_DATA_DIR).
TRADING_JOURNAL_DB_NAME=trading_journal.db

# Optional: fully override the SQLAlchemy database URL.
# If set, this takes precedence over DATA_DIR / DB_NAME above.
# TRADING_JOURNAL_DATABASE_URL=sqlite:///data/trading_journal.db

# Set to 1 to echo SQL statements (useful for debugging).
TRADING_JOURNAL_SQL_ECHO=0
